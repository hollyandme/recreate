{
  "name": "recreate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "migrate": "npm run migrate --workspace=server",
    "migrate:prod": "npm run migrate:prod --workspace=server",
    "seed": "npm run seed --workspace=server",
    "seed:prod": "npm run seed:prod --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server"
  }
}
