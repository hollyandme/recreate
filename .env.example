# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/recreate

# TLS to Postgres. Unset/"disable" for a local socket. Managed Postgres needs
# "require" (TLS on, certificate not verified) — most hosts present a cert Node
# will not verify by default. Use "verify" with DATABASE_CA if you have the CA.
# DATABASE_SSL=require

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# Where the Vite dev server runs. CORS is applied in development only.
CLIENT_ORIGIN=http://localhost:5173

# ── Screenshot storage ──────────────────────────────────────────────────────
# Leave S3_BUCKET unset to store uploads on local disk under UPLOAD_DIR.
UPLOAD_DIR=uploads

# Set S3_BUCKET to switch to object storage. Credentials come from the standard
# AWS environment variables or the instance role. S3_ENDPOINT targets an
# S3-compatible service such as Cloudflare R2 or MinIO.
# S3_BUCKET=recreate-shots
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
